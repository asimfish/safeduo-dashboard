  "sources": {
    "build_report.py": {
      "path": "/home/liyufeng/safeduo/artifacts/safety_zero_intent_20261006_2225/build_report.py",
      "sha256": "2499220ad6f6237717d7c5f14ad1712e9eb22a1dbbbeb9f711db008f89e5d143",
      "text": "\"\"\"Generate the actual closed report before final independent report review.\"\"\"\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nimport hashlib,json\nfrom candidate_decision import decide\n\nHERE=Path(__file__).resolve().parent\ndef load(n):return json.loads((HERE/n).read_text())\ndef sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\ndef write(n,text):\n    with (HERE/n).open('x') as f:f.write(text)\ndef main():\n    for n in ['ALL_ANALYSIS_EXECUTION.json','ASTRA_ZERO_FINAL_SCORE.json','ZERO_INTENT_AUDIT.json']:\n        assert load(n)['status'].startswith('PASS'),n\n    r=load('holdout_results.json');v=load('visual_verification.json');b=load('bank_audit.json');c=load('command_audit.json')\n    z=load('ZERO_INTENT_AUDIT.json');decision=decide(r)\n    assert r['completed_method_windows']==576 and r['invalid_method_windows']==0\n    t={x['mode']:x for x in r['totals']}\n    lines=['六步延迟下的零输入目标保持实验','',\n        decision['text']+'。该判定依据提前登记的规则；软件不变式通过不等于物理安全。','',\n        '完成192个新资格初态×三条件=576个方法窗口，各960帧；无效窗口0。所有严格/深度计分包含最初60帧零输入。','',\n        '| 条件 | 严格失败/192 | 深度失败/192 | 严格环境帧 | 深度环境帧 | 最小距离mm | 关节L2路径均值rad | 四臂同时运动比例 |',\n        '|---|---:|---:|---:|---:|---:|---:|---:|']\n    for x in r['totals']:\n        lines.append(f\"| {x['mode']} | {x['violations']} | {x['deep']} | {x['strict_env_steps']} | {x['deep_env_steps']} | {x['min_nonexempt_mm']:.6f} | {x['joint_path_l2_mean_rad']:.9f} | {x['four_arms_moving_fraction']:.9f} |\")\n    lines+=['','严格：原始全部非豁免表示距离float32 <0；深度：<−float32(0.005)m，无计分epsilon。环境帧相关，不能作为IID可靠性样本。','',\n        '| 块 | 对照→候选 | 救回 | 新失败 | 均失败 | 均无失败 |','|---|---|---:|---:|---:|---:|']\n    for p in r['paired']:lines.append(f\"| {p['seed']} | {p['a']}→{p['b']} | {p['rescued']} | {p['new_failures']} | {p['both']} | {p['neither']} |\")\n    lines+=['',\n        '机制：候选只扩展原0.010rad参考区间，使保持当前已发目标的零增量处于原速度盒/软限位内。若原可达区间本身排除零，候选报错而不是扩大原限位。原参考0.050rad与原收紧0.010rad是对照。原演员32行观测、有限30次原投影、R19、速度盒、阈值/豁免、全9021表示几何及六个不可撤销待执行目标均保留。','',\n        '零输入保持仅针对参考预限幅。原安全投影仍可返回非零指令，实际目标与测量位置也可能继续变化。保留原投影返回值；不强制执行零，也不清空FIFO。完整雅可比每帧有限检查属于冻结生产程序；仅固定/失败时刻保存选中J，不声称独立复算每帧全J。','',\n        '| 条件 | 零前缀失败/192 | 严格环境帧 | 零被边界排除 | 参考预限幅注入非零 | 原投影返回非零 | 目标增量非零 | 相对初始测量q的最大已发目标位移rad |','|---|---:|---:|---:|---:|---:|---:|---:|']\n    for x in z['summary']:\n        lines.append(f\"| {x['mode']} | {x['zero_prefix_strict_windows']} | {x['zero_prefix_strict_env_steps']} | {x['bounds_excluding_zero_env_steps']} | {x['reference_prelimit_injection_env_steps']} | {x['original_projector_nonzero_return_env_steps']} | {x['nonzero_effective_target_env_steps']} | {x['maximum_target_drift_rad']:.9f} |\")\n    lines+=['','该零输入审计及不变式在新结果前注册。同一保存前态的CPU区间回放不是另一条物理轨迹，也不证明唯一原因；第t帧新目标不能越过前六个待执行目标直接影响同帧失败。','',\n        f\"随机性：六个OS熵种子、三块各64初态。192初态与枚举的{b['prior_compared']}个历史初态无精确重复，最小关节L2距离{b['minimum_l2_distance_rad']:.12f}rad；实际192输入与{c['prior_unique_tapes']}个枚举旧输入无重复。每块六臂对各8个、全局16个；资格仅依赖原几何及原始零输入60步稳定性。所有候选与拒绝存档。条件采样不是IID可靠性或完整26维覆盖证明。\",'',\n        '实际运动、各关节初始/访问覆盖及六臂对风险暴露见完整结果。运动减少或暴露不足不被称为安全改善。','',\n        '保存所有首次失败前态与原选中安全/alpha/界矩阵，及0/60/62/66/71/75/180/480/959九点全部5184状态/10368机器人集合的HiGHS诊断。归一化binary64求解容差1e-9不是物理计分epsilon；固定采样不证明每帧非线性可行性。','',\n        f\"真实相机：{v['groups']}组、{v['images']}张1280×720原始PNG，每组九视角，各自state/目标/FIFO与全64native q/qd/root/rootvelocity渲染前后绑定。固定组覆盖六臂对与全局槽75/480/959，另含各分层最早实际相机负几何组。128个独立相机执行复用首块银行和输入，不增加192初态/576数值分母。\"]\n    for x in v['runs']:\n        lines.append(f\"相机{x['mode']}对数值轨迹精确重放：{x['binding_status']}，最大q差{x['q_max_difference']}rad。图像绑定自己的相机执行状态，不冒充数值轨迹截图。\")\n    lines+=['','实际USD相机变换、内参、六个视锥平面和目标组表示球检查不等于全mesh轮廓、无遮挡或硬件安全。独立查看原图子集的数量和边界见最终Astra相机回执；未查看图片不作像素审查声称。','',\n        '流程偏差必须保留：初始GPU空闲内存门禁实际失败，父级编排错误仍启动了三组基线。早期三组基线与其包装进程被精确SIGSTOP暂停；无完整960窗口、收紧/保持目标候选尚未启动。同一进程在实际容量满足恢复规则后SIGCONT继续，没有重启、重置状态/FIFO或丢弃原片段。基线独有的墙钟暂停和初始内存门禁违反属于实验流程偏差，限制“干净预注册执行”及效应因果归因；原失败不改为PASS。固定仿真dt、源文件、银行和指令未改。全部实测窗口、源与FIFO仍须逐项验收。','',\n        '父级8项CPU不变式测试；专门GPT-6 Astra xhigh独立20项CPU契约测试及5种错误变体检出、32项原始计分合成测试在新结果前通过，独立计分源码在新结果前冻结。最终源码/实际报告/完整原始计分/原图子集的独立复核与发布验收分别留存。所有结果仅限仿真研究，未批准真机或生产推广。','']\n    write('REPORT.md','\\n'.join(lines))\n    write('REPRODUCE.md','从RANDOM_EXPERIMENT_DESIGN、NUMERIC_REGISTRATION与plans读取真实初态/输入种子、原演员和源哈希；先用原几何及原始零输入资格筛选，核对bank_audit，再使用不可变计划运行三个条件。独立scorer/math来源见ASTRA_ZERO_RAW_SOURCE_REGISTRATION。必须保留初始内存门禁失败和暂停/恢复链，不能声称无流程偏差。所有原始逐帧、选中J/首失败/相机native数据保存在RAW双次完整回读档案；公开附属证据在asset_manifest所绑定固定提交，PNG无像素转换。复现实验应另建namespace、新资格银行；封存目录只读。\\n')\n    write('NEXT.md','下一轮先依据完整配对结果区分参考注入修复、投影残余和实际六步跟踪债务。若候选仍有失败，围绕实际先行目标/速度及提前可行性和非线性不确定性开展开发反事实，再用全新预注册银行验证。先检查任何新增失败与运动/暴露差异；不在本192初态上调参后宣称新盲测。运行编排必须把资源检查与启动置于同一有条件控制路径，保持其他任务不受影响。继续实际足够九视角和自身state绑定、专门Astra独立计分，保留所有不利结果。\\n')\n    write('CANDIDATE_DECISION.json',json.dumps(dict(status='DESCRIPTIVE_REGISTERED_DECISION_APPLIED',**decision,physical_safety_certified=False,hardware_approved=False,production_promoted=False),indent=2,ensure_ascii=False)+'\\n')\n    write('REPORT_BUILD.json',json.dumps(dict(status='READY_FOR_FINAL_INDEPENDENT_REPORT_REVIEW',report_sha256=sha(HERE/'REPORT.md'),decision=decision,utc=datetime.now(timezone.utc).isoformat()),indent=2,ensure_ascii=False)+'\\n')\n    print('REPORT_READY',decision['code'],flush=True)\nif __name__=='__main__':main()\n"
    },
    "panel_template.html": {
      "path": "/home/liyufeng/safeduo/artifacts/safety_zero_intent_20261006_2225/panel_template.html",
      "sha256": "287332d135bb79e4233dd77d7e759250d2c50a183786f629a44492df851ed0ab",
      "text": "<!doctype html>\n<html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>SafeDuo · 零输入目标保持实验</title>\n<style>\n:root{color-scheme:dark;--bg:#0b1422;--panel:#142238;--text:#e4edf8;--muted:#a8bad0;--line:#304664;--warn:#ffba7b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.65 system-ui,sans-serif}main{max-width:1240px;margin:auto;padding:28px 18px 70px}h1{font-size:30px;line-height:1.35}h2{font-size:21px;margin:0 0 12px}p{margin:10px 0}.sub,small{color:var(--muted)}a{color:#8fcbff;overflow-wrap:anywhere}section{background:var(--panel);padding:22px;border:1px solid var(--line);border-radius:14px;margin:18px 0}.warn{border-left:4px solid var(--warn);padding-left:14px}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;white-space:nowrap}th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line)}th{color:var(--muted)}select,button{background:#21364e;color:var(--text);border:1px solid #526d8d;padding:8px;border-radius:6px;max-width:100%;font:inherit}label{display:inline-flex;gap:8px;align-items:center;margin:6px 12px 6px 0;max-width:100%}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}.stat{border:1px solid var(--line);padding:15px;border-radius:9px}.stat b{font-size:23px;display:block}.cases{display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:5px;max-height:340px;overflow:auto;margin:12px 0}.case{padding:6px 3px;font-size:12px}.case.rescued{background:#216656}.case.new{background:#9a374c}.case.both{background:#755425}.case.neither{background:#26394f}.case[aria-current=true]{outline:2px solid white}.plot{width:100%;height:auto;min-height:180px}.plots{display:grid;grid-template-columns:1fr 1fr;gap:10px}svg text{fill:var(--muted);font:12px system-ui}svg polyline{fill:none;stroke-width:1.5}svg .threshold{stroke:#ff8791;stroke-dasharray:5 4;stroke-width:1}.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}.gallery figure{margin:0}.gallery img{width:100%;height:auto;border-radius:8px;background:#09111d}.links{display:flex;flex-wrap:wrap;gap:8px 18px}.links a{min-width:0;max-width:100%;overflow-wrap:anywhere}.heat{width:100%;height:auto}pre{white-space:pre-wrap;overflow-wrap:anywhere}.pill{display:inline-block;padding:2px 9px;border:1px solid var(--line);border-radius:30px}.error{color:#ff969e}@media(max-width:650px){h1{font-size:24px}section{padding:15px}.plots{grid-template-columns:1fr}label{display:flex;flex-wrap:wrap}.gallery{grid-template-columns:1fr}}\n</style>\n<main><a href=\"../../\">← 完整研究面板</a><h1>六步执行延迟下，允许保持目标能否减少失败？</h1><p class=\"sub\">全新随机初态与输入 · 三方法配对 · 严格几何指标 · 独立状态绑定的真实九视角</p><p id=\"loading\">正在读取已封存的完整实验结果…</p>\n<div id=\"content\" hidden>\n<section><p class=\"warn\" id=\"verdict\"></p><div id=\"stats\" class=\"grid\"></div><p id=\"scope\" class=\"sub\"></p><p id=\"invariantNote\" class=\"warn\"></p></section>\n<section><h2>完整结果与运动代价</h2><div class=\"scroll\"><table id=\"totals\"></table></div><p class=\"sub\">严格：原始非豁免距离 &lt; 0；深度：&lt; −5 mm。持续时间按环境帧计数，不能当作独立事件或实机可靠性。实际关节路径用于观察运动代价。</p><img src=\"comparison.png\" alt=\"完整失败数、违规持续时间、真实关节路径和四臂运动比例\" style=\"width:100%;height:auto\"><h3>四类原始几何失败</h3><div class=\"scroll\"><table id=\"classResults\"></table></div><p class=\"sub\">同一窗口可以同时涉及多类几何违规，分类计数不能直接相加为总窗口数。</p><div class=\"scroll\"><table id=\"paired\"></table></div></section>\n<section><h2>全部 192 个配对案例</h2><p>颜色表示原参考与保持目标候选的变化：绿色救回，红色新增失败，棕色均失败，蓝色均无失败。</p><label>风险分层 <select id=\"stratum\"></select></label><label>配对结果 <select id=\"outcome\"></select></label><span id=\"filterCount\" class=\"pill\"></span><div id=\"heatmap\" class=\"cases\"></div><label>案例 <select id=\"case\"></select></label><label>方法 <select id=\"method\"></select></label><p id=\"caseNote\"></p><div id=\"curves\" class=\"plots\"></div><p class=\"sub\">保存每四帧曲线，并额外保留终点、各类最小距离、首次负距离及执行量峰值。完整逐帧数据保存在 NAS 封存档案中；抽样曲线不替代逐帧计分。</p></section>\n<section><h2>实际覆盖和相遇暴露</h2><label>方法 <select id=\"coverageMode\"></select></label><label>阶段 <select id=\"coverageStage\"><option value=\"initial_joint\">初始关节</option><option value=\"visited_joint\">实际到达关节</option></select></label><svg id=\"coverage\" class=\"heat\" viewBox=\"0 0 950 610\" aria-label=\"26关节乘10区间的实际覆盖\"></svg><p id=\"coverageNote\"></p><div class=\"scroll\"><table id=\"exposure\"></table></div><p class=\"sub\">十区间边际关节计数和 10 cm 末端体素来自实际状态。六组臂对各 24 个条件初态，加 48 个全局初态；不等于完整 26 维可达空间或全部动力学条件。</p></section>\n<section><h2>每张真实图像绑定它自己的状态</h2><p id=\"cameraNote\"></p><label>采集组 <select id=\"cameraGroup\"></select></label><div id=\"stateLinks\" class=\"links\"></div><div id=\"gallery\" class=\"gallery\"></div><p class=\"sub\">每组九个原始 1280×720 视角：总览、正面、背面、两机器人双臂与反向高低视角。检查实际 USD 相机和六个视锥平面；不宣称遮挡消除、全部网格轮廓覆盖或实机认证。</p></section>\n<section><h2>首次失败与约束可行性</h2><p id=\"failureNote\"></p><div class=\"scroll\"><table id=\"failures\"></table></div><h3>零指令前缀：额外运动与早期失败</h3><div class=\"scroll\"><table id=\"zeroIntent\"></table></div><p class=\"sub\">零输入不变式和前缀审计在新策略结果出现前注册。完整保留60帧前缀、实际投影修正与所有失败，不修改计分或分母。</p><h3>九个固定时间点：全部初态的线性集合</h3><div class=\"scroll\"><table id=\"fixedFeasibility\"></table></div><p class=\"sub\">每行192个配对初态；前态步骤0/60/62/66/71/75/180/480/959。固定采样不等于每帧可行性或完整非线性可达性。</p><p class=\"sub\">可行性是保存的浮点线性集合的 HiGHS 诊断，不是物理安全或唯一因果证明。前六个目标不可撤销；当前发出的目标在第七个执行位置生效。</p></section>\n<section><h2>方法、复现与完整证据</h2><p>候选把原0.01 rad参考区间扩展到允许保持当前目标，扩展仍处于原速度盒和软限位内。参考预限幅不再仅因测量漂移产生非零指令；原安全投影仍可输出非零修正。三方法共享原演员、目标风险行准入、有限求解器、物理阈值和真实六步 FIFO。</p><p>零输入保持是参考变换的不变式，不能替代动态安全性。六个排队目标不可撤销；冻结雅可比风险预测只作诊断。初态属于资格条件采样；完整报告实际运动、暴露不足及失败，不作IID可靠性或全26维空间覆盖证明。</p><p class=\"warn\" id=\"executionNote\"></p><p id=\"reviewNote\"></p><div id=\"downloads\" class=\"links\"></div><p><a id=\"fullResults\">完整逐案例结果（无损 gzip）</a></p></section>\n</div></main>\n<script>\nconst $=id=>document.getElementById(id);\nconst names={joint_reference:'原参考 0.05 rad',tight_reference:'固定收紧 0.01 rad',zero_inclusive:'允许保持目标 0.01 rad'};\nconst strata={'-1':'全局随机',0:'F左 / F右',1:'F左 / U左',2:'F左 / U右',3:'F右 / U左',4:'F右 / U右',5:'U左 / U右'};\nconst colors=['#79bcff','#81dbbd','#f0c87a','#ed8fba'];\nconst table=(id,headers,rows)=>{$(id).replaceChildren();const head=document.createElement('tr');for(const value of headers){const th=document.createElement('th');th.textContent=value;head.append(th)}$(id).append(head);for(const row of rows){const tr=document.createElement('tr');for(const value of row){const td=document.createElement('td');if(value instanceof Node)td.append(value);else td.textContent=value;tr.append(td)}$(id).append(tr)}};\nconst option=(id,value,text)=>{const o=document.createElement('option');o.value=value;o.textContent=text;$(id).append(o)};\nconst fmt=(v,n=2)=>Number(v).toFixed(n);\nconst anchor=(href,label)=>{const a=document.createElement('a');a.href=href;a.textContent=label;return a};\nconst unpack=async url=>{const response=await fetch(url);if(!response.ok)throw Error('证据读取失败 '+response.status);return JSON.parse(await new Response(response.body.pipeThrough(new DecompressionStream('gzip'))).text())};\nconst svgNode=(name,attrs)=>{const n=document.createElementNS('http://www.w3.org/2000/svg',name);for(const [k,v] of Object.entries(attrs))n.setAttribute(k,v);return n};\nconst category=c=>{const a=c.methods.joint_reference.failed,b=c.methods.zero_inclusive.failed;return a?(b?'both':'rescued'):(b?'new':'neither')};\nlet D,R;\nconst renderCases=()=>{const chosen=R.cases.map((c,i)=>({c,i})).filter(({c})=>($('stratum').value==='all'||String(c.stratum)===$('stratum').value)&&($('outcome').value==='all'||category(c)===$('outcome').value));$('heatmap').replaceChildren();for(const {c,i} of chosen){const b=document.createElement('button');b.className='case '+category(c);b.textContent=`${D.blocks[c.seed]}:${c.env}`;b.title=`${strata[c.stratum]} · ${category(c)}`;b.dataset.index=i;b.setAttribute('aria-current',String(i===Number($('case').value)));b.onclick=()=>{$('case').value=i;renderCase();renderCases()};$('heatmap').append(b)}$('filterCount').textContent=`${chosen.length} / ${R.cases.length}`};\nconst draw=(title,series,x)=>{const svg=svgNode('svg',{viewBox:'0 0 550 270',class:'plot','aria-label':title});const values=series.flatMap(s=>s.values);const lo=Math.min(title.includes(\"mm\")?-5:0,...values),hi=Math.max(0,...values),span=Math.max(1,hi-lo);const tx=v=>48+v/959*478,ty=v=>230-(v-lo)/span*180;const label=svgNode('text',{x:12,y:20});label.textContent=title;svg.append(label);svg.append(svgNode('line',{x1:48,x2:526,y1:ty(0),y2:ty(0),class:'threshold'}));for(const y of [lo,hi]){const t=svgNode('text',{x:2,y:ty(y)+4});t.textContent=fmt(y,1);svg.append(t)}for(const [i,s]of series.entries()){svg.append(svgNode('polyline',{points:s.values.map((v,j)=>`${tx(x[j])},${ty(v)}`).join(' '),stroke:colors[i]}));const t=svgNode('text',{x:48+i*115,y:256,style:`fill:${colors[i]}`});t.textContent=s.name;svg.append(t)}return svg};\nconst renderCase=()=>{const c=R.cases[Number($('case').value)],m=$('method').value,s=c.methods[m];$('caseNote').textContent=`块 ${D.blocks[c.seed]} · 初态 ${c.env} · ${strata[c.stratum]} · ${names[m]}：${s.failed?'严格失败':'该窗口未出现严格失败'}，${s.deep?'有深度违规':'无深度违规'}；首次负距离帧 ${s.first_failure_step===null?'无':s.first_failure_step}。`;$('curves').replaceChildren();$('curves').append(draw('原始非豁免距离 / mm',['跨机','F自碰','U自碰','桌面'].map((name,i)=>({name,values:s.curves.map(r=>r[i])})),s.indices));$('curves').append(draw('跟踪债务、速度与目标增量 / rad 或 rad/s',['债务 rad','速度 rad/s','目标增量 rad'].map((name,i)=>({name,values:s.actuation.map(r=>r[i])})),s.indices));window.SAFEDUO_SELECTION={case:Number($('case').value),method:m,curves:s.curves,actuation:s.actuation,indices:s.indices}};\nconst renderCoverage=()=>{const c=R.coverage.find(c=>c.mode===$('coverageMode').value).measured,grid=c[$('coverageStage').value];$('coverage').replaceChildren();const max=Math.max(...grid.counts.flat());for(let j=0;j<26;j++){const text=svgNode('text',{x:4,y:32+j*21});text.textContent=`关节 ${j+1}`;$('coverage').append(text);for(let b=0;b<10;b++){const count=grid.counts[j][b],rect=svgNode('rect',{x:80+b*85,y:18+j*21,width:78,height:17,fill:`rgba(101,192,233,${count?0.2+0.8*Math.log1p(count)/Math.log1p(max):0.03})`});const title=svgNode('title',{});title.textContent=`关节${j+1} 区间${b+1}：${count}`;rect.append(title);$('coverage').append(rect)}}$('coverageNote').textContent=`边际区间占用 ${fmt(grid.mean_visited_fraction*100,1)}%；窗口内关节归一化范围均值 ${fmt(c.mean_within_window_joint_range*100,2)}%；实际总关节路径均值 ${fmt(c.mean_joint_path_rad)} rad；四臂末端体素 ${c.visited_ee.visited_voxels_per_arm.join(' / ')}。`;table('exposure',['臂对','分配初态','相遇暴露','不足暴露'],R.exposure.filter(e=>e.mode===$('coverageMode').value).map(e=>[e.name,e.assigned,e.exposed,e.underexposed]))};\nconst renderGallery=()=>{const g=D.visual.galleries[Number($('cameraGroup').value)],base=D.assetBase+'visual/'+g.mode+'/';$('stateLinks').replaceChildren(anchor(base+g.state,'本组实际状态 JSON'),anchor(base+g.before,'渲染前 native NPZ'),anchor(base+g.after,'渲染后 native NPZ'));$('gallery').replaceChildren();for(const im of g.images){const figure=document.createElement('figure'),img=document.createElement('img'),caption=document.createElement('figcaption');img.src=base+im.path;img.alt=im.view;img.loading='lazy';caption.textContent=`${names[g.mode]} · ${im.view} · env ${g.env} / 帧 ${g.step}`;figure.append(img,caption);$('gallery').append(figure)}};\nconst main=async()=>{D=await unpack('payload.json.gz');R=await unpack(D.assetBase+'data/holdout_results.json.gz');window.SAFEDUO={payload:D,result:R};$('verdict').textContent=D.verdict;for(const [label,value]of [['新初态',R.cases.length],['完成方法窗口',R.completed_method_windows],['无效窗口',R.invalid_method_windows],['原始九视角图像',D.visual.images]]){const box=document.createElement('div');box.className='stat';const b=document.createElement('b');b.textContent=value;box.append(b,document.createTextNode(label));$('stats').append(box)}$('scope').textContent=`三个独立种子块，各64个初态 × 三方法 × 960帧。${D.bank.fresh} 个初态相对枚举的 ${D.bank.prior_compared} 个历史初态无重复；${D.commands.fresh_unique_tapes} 条实际输入相对 ${D.commands.prior_unique_tapes} 条历史输入无重复。`;\n$('invariantNote').textContent=`候选在 ${D.invariant.candidate_env_steps} 个环境帧中，参考区间允许保持当前目标。60帧零输入前缀中，参考预限幅注入非零动作 ${D.invariant.prefix_reference_injection_env_steps} 环境帧；原安全投影返回非零 ${D.invariant.prefix_projector_nonzero_env_steps} 环境帧。允许保持目标不等于强制零动作，也不保证物理安全。`;table('totals',['方法','严格失败 / 192','深度失败 / 192','严格环境帧','深度环境帧','最小距离 mm','路径 L2 rad','四臂运动 %','执行/原输入'],R.totals.map(t=>[names[t.mode],t.violations,t.deep,t.strict_env_steps,t.deep_env_steps,fmt(t.min_nonexempt_mm),fmt(t.joint_path_l2_mean_rad),fmt(t.four_arms_moving_fraction*100,1),fmt(t.exec_external_l2_ratio,3)]));table('paired',['种子块','对照 → 候选','救回','新增失败','均失败','均无失败'],R.paired.map(p=>[D.blocks[p.seed],`${names[p.a]} → ${names[p.b]}`,p.rescued,p.new_failures,p.both,p.neither]));option('stratum','all','全部');for(const [key,value]of Object.entries(strata))option('stratum',key,value);for(const [key,value]of Object.entries({all:'全部',rescued:'救回',new:'新增失败',both:'均失败',neither:'均无失败'}))option('outcome',key,value);R.cases.forEach((c,i)=>option('case',i,`块${D.blocks[c.seed]} / env${c.env} / ${strata[c.stratum]}`));for(const m of D.modes){option('method',m,names[m]);option('coverageMode',m,names[m])}$('method').value='zero_inclusive';$('coverageMode').value='zero_inclusive';$('stratum').onchange=renderCases;$('outcome').onchange=renderCases;$('case').onchange=()=>{renderCase();renderCases()};$('method').onchange=renderCase;$('coverageMode').onchange=renderCoverage;$('coverageStage').onchange=renderCoverage;renderCases();renderCase();renderCoverage();\ntable('classResults',['方法','几何类别','严格失败 /192','深度失败 /192','严格环境帧','深度环境帧'],D.classSummary.map(r=>[names[r.mode],{cross:'跨机',self_F:'F自碰',self_U:'U自碰',table:'桌面'}[r.kind],r.strict_windows,r.deep_windows,r.strict_env_steps,r.deep_env_steps]));\n$('cameraNote').textContent=D.cameraText;D.visual.galleries.forEach((g,i)=>option('cameraGroup',i,`${names[g.mode]} / ${g.kind==='scheduled'?'固定采集':'本次相机轨迹首次失败'} / env${g.env} / 帧${g.step}`));$('cameraGroup').onchange=renderGallery;renderGallery();$('failureNote').textContent=`完整保存 ${D.failure.cases} 个首次失败案例，按每个方法自己的实际轨迹分析。`;table('failures',['方法','块 / env / 帧','最近行此前准入','F线性集合','U线性集合','前态速度 rad/s','目标债务 rad','原始快照'],D.failure.records.map(r=>[names[r.mode],`${D.blocks[r.seed]} / ${r.env} / ${r.first_failure_step}`,r.nearest_selected_previous?'是':'否',r.joint_set_checks.F.hard_set_feasible?'可行':'不可行',r.joint_set_checks.U.hard_set_feasible?'可行':'不可行',fmt(r.maximum_pre_qd_rad_s,3),fmt(r.maximum_pre_target_debt_rad,3),anchor(D.assetBase+r.snapshot_relative,'NPZ')]));table('zeroIntent',['方法','零指令失败 /192','严格环境帧','边界排除零环境帧','目标增量非零环境帧','参考注入非零环境帧','原投影返回非零环境帧','相对初始测量q的最大已发目标位移 rad'],D.zeroSummary.map(r=>[names[r.mode],r.zero_prefix_strict_windows,r.zero_prefix_strict_env_steps,r.bounds_excluding_zero_env_steps,r.nonzero_effective_target_env_steps,r.reference_prelimit_injection_env_steps,r.original_projector_nonzero_return_env_steps,fmt(r.maximum_target_drift_rad,4)]));table('fixedFeasibility',['方法','前态帧','诊断初态','F集合不可行','U集合不可行'],D.fixedSummary.map(r=>[names[r.mode],r.pre_step,r.cases,r.F_infeasible,r.U_infeasible]));$('executionNote').textContent=D.executionText;$('reviewNote').textContent=D.reviewText;for(const doc of D.docs)$('downloads').append(anchor(doc.path,doc.title));$('fullResults').href=D.assetBase+'data/holdout_results.json.gz';$('loading').hidden=true;$('content').hidden=false;window.SAFEDUO_READY=true};\nmain().catch(error=>{$('loading').textContent='证据读取未完成：'+error.message;$('loading').className='error';console.error(error)});\n</script></html>\n"
    }
  },
  "prior_snapshot_sha256": "531b5caa3e424746d4609358a3b23895e32b97c31936aff578dfa183a4d07409"
