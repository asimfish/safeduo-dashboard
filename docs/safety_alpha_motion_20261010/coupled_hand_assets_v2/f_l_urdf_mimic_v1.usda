#usda 1.0
(
    defaultPrim = "Robot"
    subLayers = [
        @/home/liyufeng/safeduo/assets_real/usd/combined/fr3_f2_left_v5.usd@
    ]
)

over "Robot"
{
    over "f2_hand"
    {
        over "joints"
        {
            over "left_thumb_3_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxMimicJointAPI:rotZ"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                float physxMimicJoint:rotZ:dampingRatio = 0
                float physxMimicJoint:rotZ:gearing = -0.7222
                float physxMimicJoint:rotZ:naturalFrequency = 0
                float physxMimicJoint:rotZ:offset = -0
                rel physxMimicJoint:rotZ:referenceJoint = </Robot/f2_hand/joints/left_thumb_2_joint>
                uniform token physxMimicJoint:rotZ:referenceJointAxis = "rotZ"
            }

            over "left_thumb_4_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxMimicJointAPI:rotZ"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                float physxMimicJoint:rotZ:dampingRatio = 0
                float physxMimicJoint:rotZ:gearing = -0.69754
                float physxMimicJoint:rotZ:naturalFrequency = 0
                float physxMimicJoint:rotZ:offset = -0
                rel physxMimicJoint:rotZ:referenceJoint = </Robot/f2_hand/joints/left_thumb_3_joint>
                uniform token physxMimicJoint:rotZ:referenceJointAxis = "rotZ"
            }

            over "left_index_2_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxMimicJointAPI:rotZ"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                float physxMimicJoint:rotZ:dampingRatio = 0
                float physxMimicJoint:rotZ:gearing = -1.1545
