#usda 1.0
(
    defaultPrim = "Robot"
    subLayers = [
        @/home/liyufeng/safeduo/artifacts/safety_physical_qualified_random_20261009_1613/fourhand_native_probe_v14/fr3_f2_right_explicit_axes_v1.usda@
    ]
)

over "Robot"
{
    over "f2_hand"
    {
        over "joints"
        {
            over "right_thumb_3_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxMimicJointAPI:rotX"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = -0.7222
                float physxMimicJoint:rotX:naturalFrequency = 0
                float physxMimicJoint:rotX:offset = -0
                rel physxMimicJoint:rotX:referenceJoint = </Robot/f2_hand/joints/right_thumb_2_joint>
                uniform token physxMimicJoint:rotX:referenceJointAxis = "rotZ"
            }

            over "right_thumb_4_joint" (
